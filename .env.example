# ─────────────────────────────────────────────────────────────
# INNOVISION 2026 — environment contract
# Copy to .env.local and fill in. .env.local is gitignored.
# ─────────────────────────────────────────────────────────────

MONGO_URI=""
MONGO_DB=""
MONGO_TRANSACTIONS=""

BETTER_AUTH_SECRET=""
BETTER_AUTH_URL=""

 
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional: where uploads land inside your Cloudinary media library.
# CLOUDINARY_FOLDER="innovision2026/id-cards"

# ---- Transactional email (sign-in codes) --------------------
# Used by the email one-time-code sign-in. Without a key, codes are
# printed to the server log in development and refused in production.
# resend.com > API Keys
RESEND_API_KEY=""

# Must be a domain you have verified with Resend.
# Resend's shared sandbox sender only delivers to your own account address.
EMAIL_FROM=""
